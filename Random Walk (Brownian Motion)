import numpy as np
import matplotlib.pyplot as plt

# 1. Define Initial Parameters
n_steps = 10000  # Number of random collisions

# 2. Generate Random Steps
# np.random.randn generates random numbers based on a standard bell curve.
# Most bumps will be small, but occasionally the particle gets a hard push.
dx = np.random.randn(n_steps)
dy = np.random.randn(n_steps)

# Force the starting point to be exactly (0,0)
dx[0] = 0
dy[0] = 0

# 3. Calculate Positions (The Magic of Cumulative Sum)
# Instead of a slow loop, cumsum instantly calculates the running total of the steps.
x_positions = np.cumsum(dx)
y_positions = np.cumsum(dy)

# 4. Visualize the Chaos
plt.figure(figsize=(8, 8))

# Plot the entire path as a thin, semi-transparent line
plt.plot(x_positions, y_positions, color='teal', linewidth=0.5, alpha=0.8)

# Mark the starting point in green and the ending point in red
plt.plot(0, 0, 'go', markersize=10, label='Start')
plt.plot(x_positions[-1], y_positions[-1], 'ro', markersize=10, label='End')

# Formatting the graph
plt.title('2D Random Walk (Brownian Motion)')
plt.xlabel('X Position')
plt.ylabel('Y Position')
plt.axis('equal')  # Ensure the grid doesn't stretch
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()
